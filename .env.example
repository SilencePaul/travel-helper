# Browser-safe AMap credentials used only by Vite; never commit real values.
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
# Server-only credential for scripts/functions. Never prefix this value with VITE_.
AMAP_WEB_SERVICE_KEY=
VITE_DATA_MODE=local

# CloudBase environment ID is safe to expose to the browser; credentials below are server/deploy only.
VITE_CLOUDBASE_ENV_ID=
# Public URL of the deployed auth-service HTTP function (not same-origin by assumption).
VITE_AUTH_SERVICE_URL=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
CLOUDBASE_CUSTOM_LOGIN_CREDENTIALS_BASE64=

# Feishu OAuth credentials are server-only. Set the redirect URI to the deployed HTTPS callback later.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:5173/api/auth/feishu/callback

# Public base URL used to construct server-side OAuth redirects.
PUBLIC_APP_URL=http://localhost:5173

# One-time code used to initialize the first administrator; keep server-only.
ADMIN_BOOTSTRAP_CODE=

# Long random value used to sign the server session; never expose it to Vite.
AUTH_SESSION_SECRET=
