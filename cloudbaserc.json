{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "{{env.VITE_CLOUDBASE_ENV_ID}}",
  "functionRoot": "./functions",
  "functions": [
    {
      "name": "auth-service",
      "type": "Event",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 30,
      "installDependency": true,
      "envVariables": {
        "VITE_CLOUDBASE_ENV_ID": "{{env.VITE_CLOUDBASE_ENV_ID}}",
        "FEISHU_APP_ID": "{{env.FEISHU_APP_ID}}",
        "FEISHU_APP_SECRET": "{{env.FEISHU_APP_SECRET}}",
        "FEISHU_REDIRECT_URI": "{{env.FEISHU_REDIRECT_URI}}",
        "ADMIN_BOOTSTRAP_CODE": "{{env.ADMIN_BOOTSTRAP_CODE}}",
        "BOOTSTRAP_TRIP_ID": "trip-2026-gba",
        "CLOUDBASE_CUSTOM_LOGIN_CREDENTIALS_BASE64": "{{env.CLOUDBASE_CUSTOM_LOGIN_CREDENTIALS_BASE64}}",
        "CLOUDBASE_SERVER_SECRET_ID": "{{env.TENCENTCLOUD_SECRET_ID}}",
        "CLOUDBASE_SERVER_SECRET_KEY": "{{env.TENCENTCLOUD_SECRET_KEY}}",
        "PUBLIC_APP_URL": "{{env.PUBLIC_APP_URL}}"
      }
    },
    {
      "name": "trip-api",
      "type": "Event",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 20,
      "installDependency": true,
      "envVariables": {
        "VITE_CLOUDBASE_ENV_ID": "{{env.VITE_CLOUDBASE_ENV_ID}}",
        "CLOUDBASE_SERVER_SECRET_ID": "{{env.TENCENTCLOUD_SECRET_ID}}",
        "CLOUDBASE_SERVER_SECRET_KEY": "{{env.TENCENTCLOUD_SECRET_KEY}}"
      }
    },
    {
      "name": "agent-api",
      "dir": "functions/trip-api",
      "type": "Event",
      "handler": "index.agentMain",
      "runtime": "Nodejs20.19",
      "timeout": 20,
      "installDependency": true,
      "envVariables": {
        "VITE_CLOUDBASE_ENV_ID": "{{env.VITE_CLOUDBASE_ENV_ID}}",
        "CLOUDBASE_SERVER_SECRET_ID": "{{env.TENCENTCLOUD_SECRET_ID}}",
        "CLOUDBASE_SERVER_SECRET_KEY": "{{env.TENCENTCLOUD_SECRET_KEY}}"
      }
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/api/auth",
        "target": "function:auth-service",
        "enableAuth": false,
        "enablePathTransmission": false,
        "qpsPolicy": {
          "qpsTotal": 100,
          "qpsPerClient": {
            "limitBy": "ClientIP",
            "limitValue": 3
          }
        }
      },
      {
        "path": "/api/agent",
        "target": "function:agent-api",
        "enableAuth": false,
        "enablePathTransmission": true,
        "qpsPolicy": {
          "qpsTotal": 100,
          "qpsPerClient": {
            "limitBy": "ClientIP",
            "limitValue": 4
          }
        }
      }
    ]
  }
}
