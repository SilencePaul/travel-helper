{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel.local/schemas/codex-travel-discovery.schema.json",
  "title": "Codex bounded travel discovery output",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "category", "candidates"],
      "properties": {
        "status": { "const": "discovered" },
        "category": { "enum": ["hotel", "restaurant", "attraction"] },
        "candidates": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "address"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
              "address": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
            }
          }
        }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "message"],
      "properties": {
        "status": { "const": "needs_owner_action" },
        "reason": { "const": "codex_auth_required" },
        "message": { "const": "请在 ChatGPT/Codex 中恢复登录后返回此页面继续。" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "message", "sourceHostname"],
      "properties": {
        "status": { "const": "needs_owner_action" },
        "reason": { "enum": ["source_login_required", "source_captcha", "source_risk_control"] },
        "message": { "const": "请在来源网站中完成所需操作后返回此页面继续。" },
        "sourceHostname": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$" }
      }
    }
  ]
}
