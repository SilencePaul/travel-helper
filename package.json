{
  "name": "travel-planner",
  "private": true,
  "packageManager": "pnpm@11.0.5",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:amap-capability && pnpm test:amap-poi-validation",
    "e2e": "playwright test",
    "test:amap-capability": "node scripts/amap-capability-check.test.mjs",
    "test:amap-poi-validation": "node scripts/amap-poi-validation.test.mjs",
    "check:amap-pois": "node --env-file=.env.local scripts/amap-poi-validation.mjs",
    "test:production-config": "node scripts/check-production-config.test.mjs",
    "check:production-config": "node --env-file=.env.local scripts/check-production-config.mjs"
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.8.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3"
  }
}
