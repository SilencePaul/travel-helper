{
  "name": "travel-planner",
  "private": true,
  "packageManager": "pnpm@11.0.5",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build:web:cloudflare": "node scripts/build-web-cloudflare.mjs",
    "briefing:prepare": "node scripts/publish-briefing.mjs",
    "briefing:publish": "bash scripts/publish-briefing.sh",
    "test:briefing": "node --test scripts/publish-briefing.test.mjs scripts/build-web-cloudflare.test.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:backend && pnpm test:operations && pnpm test:amap-capability && pnpm test:amap-poi-validation",
    "test:backend": "node --test \"functions/**/*.test.js\"",
    "test:operations": "node scripts/check-production-config.test.mjs && node --test scripts/cloudbaseSecurity.test.mjs scripts/cloudbaseSeed.test.mjs",
    "e2e": "playwright test",
    "test:amap-capability": "node scripts/amap-capability-check.test.mjs",
    "test:amap-poi-validation": "node scripts/amap-poi-validation.test.mjs",
    "check:amap-pois": "node --env-file=.env.local scripts/amap-poi-validation.mjs",
    "test:production-config": "node scripts/check-production-config.test.mjs",
    "check:production-config": "node --env-file=.env.local scripts/check-production-config.mjs",
    "seed:cloudbase": "node --env-file=.env.local scripts/seed-cloudbase.mjs",
    "apply:cloudbase-security": "node --env-file=.env.local scripts/apply-cloudbase-security.mjs"
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.8.1",
    "@cloudbase/manager-node": "^5.8.2",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3"
  }
}
